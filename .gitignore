node_modules

# Written by CI immediately before packaging (electron/build-stamp.mjs reads it).
# Never committed: a checked-in build number would claim every local build was
# the release it was copied from, and the adoption check in
# electron/proxy-adoption.mjs treats that number as an identity.
build-info.json/
dist/
.env
*.log
.DS_Store
devlog/
.tmp/
.opencode/

# Compiled Python bytecode
# The interpreter regenerates these on every import, so tracking them turned
# each edit to the Home Assistant integration's .py files into binary churn.
__pycache__/
*.pyc

# Local agent/session artifacts
# These are per-machine agent state (goalplans, ledgers, evidence scratch).
# They are never part of the product and must not be committed, not even with
# `git add -f` — see tests/repo-hygiene.test.ts, which fails if any path here
# becomes tracked again.
.codexclaw/
**/.codexclaw/
.omo/
**/.omo/

# Test-generated artifacts
tests/.tmp-*/
.claude/
*.tsbuildinfo
