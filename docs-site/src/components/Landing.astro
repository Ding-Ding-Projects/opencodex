---
/**
 * Landing page, shared by the five locales.
 *
 * Rewritten from the "liquid editorial" composition it replaced. That version
 * was a scroll-driven stack of sticky scenes with view-timelines and a rotating
 * headline drum — a design language of its own, and one that made the page a
 * single long scroll. Both are things the product's rules rule out: Material 3
 * everywhere with no parallel design system, and content reached by navigating
 * tabs rather than by scrolling past it.
 *
 * So the page is now a Material 3 surface with a browser-style tab strip, the
 * same shape the dashboard uses. Every colour resolves to an `--m3-*` role, and
 * the tabs carry real `tablist`/`tab`/`tabpanel` semantics with roving focus —
 * not links styled to look like tabs.
 *
 * Panels render server-side and only the inactive ones carry `hidden`, so a
 * visitor without JavaScript reads every section stacked instead of finding
 * four empty regions behind a control that never ran.
 */
import { Image } from 'astro:assets';
import {
	siAnthropic,
	siDeepseek,
	siGoogle,
	siMoonshotai,
	siOllama,
	siOpenrouter,
} from 'simple-icons';
import SiteJsonLd from './SiteJsonLd.astro';

import shotDashboard from '../assets/shots/dashboard.png';
import shotProviders from '../assets/shots/providers.png';
import shotModels from '../assets/shots/models.png';
import shotTerminal from '../assets/shots/terminal.png';
import shotHistory from '../assets/shots/history.png';
import shotRegex from '../assets/shots/regex.png';

interface Props {
	locale?: 'ko' | 'zh-cn' | 'ru' | 'ja';
}
const { locale } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = locale ? `${base}${locale}/` : base;

const t = (en: string, ko: string, zh: string, ru: string, ja: string) =>
	locale === 'ko' ? ko : locale === 'zh-cn' ? zh : locale === 'ru' ? ru : locale === 'ja' ? ja : en;

// Official monochrome marks where the brand exists in simple-icons; brands
// missing from it stay text-only rather than borrowing a generic substitute.
const providers: { label: string; path?: string }[] = [
	{ label: 'Anthropic', path: siAnthropic.path },
	{ label: 'Google', path: siGoogle.path },
	{ label: 'xAI' },
	{ label: 'Kimi', path: siMoonshotai.path },
	{ label: 'Ollama', path: siOllama.path },
	{ label: 'Groq' },
	{ label: 'OpenRouter', path: siOpenrouter.path },
	{ label: 'Azure' },
	{ label: 'DeepSeek', path: siDeepseek.path },
	{ label: 'GLM' },
];

const quickstart = [
	{ cmd: 'npm install -g @bitkyc08/opencodex', note: t('Install', '설치', '安装', 'Установка', 'インストール') },
	{ cmd: 'ocx init', note: t('Inject a provider into Codex', 'Codex에 프로바이더 주입', '向 Codex 注入 provider', 'Внедрение провайдера в Codex', 'プロバイダーを Codex に注入') },
	{ cmd: 'ocx start', note: t('Start the proxy', '프록시 시작', '启动代理', 'Запуск прокси', 'プロキシを起動') },
	{ cmd: 'codex "Write a hello world in Rust"', note: t('Codex now routes through ocx', 'Codex가 ocx를 경유', 'Codex 现在经由 ocx 路由', 'Codex теперь работает через ocx', 'Codex は ocx 経由に') },
];

const shots = [
	{ img: shotDashboard, title: t('Dashboard', '대시보드', '控制台', 'Дашборд', 'ダッシュボード'), body: t('Live proxy status, the cost meter, and a Launch card that installs what is missing.', '실시간 프록시 상태, 비용 미터, 없는 것은 설치해 주는 실행 카드.', '实时代理状态、成本计量，以及会自动安装缺失项的启动卡片。', 'Статус прокси, счётчик расходов и карточка запуска, которая доустановит недостающее.', 'プロキシの状態、コストメーター、足りないものを入れてくれる起動カード。') },
	{ img: shotProviders, title: t('Providers', '프로바이더', '提供商', 'Провайдеры', 'プロバイダー'), body: t('Grouped by state, searchable, with raw JSON when the form is not enough.', '상태별 그룹화, 검색 가능, 폼으로 부족하면 원본 JSON.', '按状态分组、可搜索，表单不够时可直接编辑 JSON。', 'Сгруппированы по состоянию, с поиском и правкой JSON.', '状態ごとに整理、検索可能、フォームで足りなければ生 JSON。') },
	{ img: shotModels, title: t('Models', '모델', '模型', 'Модели', 'モデル'), body: t('Choose what reaches Codex’s picker. Hidden models stay callable by exact id.', 'Codex 피커에 무엇을 노출할지 선택. 숨긴 모델도 정확한 id로는 호출 가능.', '决定哪些模型出现在 Codex 选择器中；隐藏的仍可用精确 id 调用。', 'Выбирайте, что попадёт в список Codex. Скрытые модели остаются доступны по точному id.', 'Codex のピッカーに出す範囲を選択。隠したモデルも正確な id でなら呼べます。') },
	{ img: shotTerminal, title: t('Terminal', '터미널', '终端', 'Терминал', 'ターミナル'), body: t('Run commands without a console window appearing, with what you sent recorded beside the output.', '콘솔 창 없이 명령 실행, 보낸 줄이 출력 옆에 기록됨.', '执行命令而不弹出控制台窗口，你发送的内容与输出并排记录。', 'Команды без всплывающего окна консоли; отправленное сохраняется рядом с выводом.', 'コンソール窓を出さずにコマンド実行。送った行も出力の横に残ります。') },
	{ img: shotHistory, title: t('Version history', '버전 기록', '版本历史', 'История версий', 'バージョン履歴'), body: t('Append-only. Restoring records a new revision, so an undo can itself be undone.', '추가 전용. 복원도 새 리비전으로 기록되어 되돌리기를 되돌릴 수 있음.', '仅追加。恢复本身也记为新修订，所以撤销还能再撤销。', 'Только добавление. Восстановление тоже пишется как ревизия, поэтому отмену можно отменить.', '追記のみ。復元も新しいリビジョンとして残るので、取り消しも取り消せます。') },
	{ img: shotRegex, title: t('Regex builder', '정규식 빌더', '正则构建器', 'Конструктор regex', '正規表現ビルダー'), body: t('Feeds every search bar with a .* toggle. Evaluated locally, never transmitted.', '.* 토글이 있는 모든 검색창에 연결. 로컬에서만 평가되며 전송되지 않음.', '为每个带 .* 开关的搜索框供能。本地求值，绝不外传。', 'Питает каждую строку поиска с переключателем .*. Вычисляется локально и никуда не отправляется.', '.* トグル付きの検索欄すべてに供給。ローカル評価のみで送信しません。') },
];

const features = [
	{ group: t('Routing', '라우팅', '路由', 'Маршрутизация', 'ルーティング'), items: [
		{ title: t('Any provider', '모든 프로바이더', '任意提供商', 'Любой провайдер', '任意のプロバイダー'), body: t('One endpoint in front of Anthropic, Google, xAI, DeepSeek, Ollama, OpenRouter and more.', '여러 프로바이더 앞의 단일 엔드포인트.', '一个端点，背后接入多家提供商。', 'Единая точка входа к множеству провайдеров.', '複数プロバイダーの前に立つ単一エンドポイント。'), href: `${prefix}guides/providers/` },
		{ title: t('Combos', '콤보', '组合', 'Комбо', 'コンボ'), body: t('Virtual models that fail over, or spread load by weighted round-robin.', '장애 조치하거나 가중 라운드로빈으로 부하를 분산하는 가상 모델.', '可故障转移或按加权轮询分摊负载的虚拟模型。', 'Виртуальные модели с отказоустойчивостью или взвешенным round-robin.', 'フェイルオーバーや加重ラウンドロビンで分散する仮想モデル。'), href: `${prefix}guides/model-routing/` },
		{ title: t('Sub-agents', '서브에이전트', '子代理', 'Подагенты', 'サブエージェント'), body: t('Choose the five models spawn_agent may offer, with per-depth ceilings.', 'spawn_agent가 제시할 다섯 모델을 선택, 깊이별 상한 포함.', '选择 spawn_agent 可提供的五个模型，并按层设上限。', 'Выберите пять моделей для spawn_agent с ограничениями по глубине.', 'spawn_agent が出せる 5 モデルを選択、深さごとに上限。'), href: `${prefix}guides/sub-agent-surface/` },
	]},
	{ group: t('Accounts', '계정', '账号', 'Аккаунты', 'アカウント'), items: [
		{ title: t('Account pooling', '계정 풀링', '账号池', 'Пул аккаунтов', 'アカウントプール'), body: t('Sticky session affinity, 429 cooldown and failover across every OAuth provider.', '세션 고정, 429 쿨다운, 모든 OAuth 프로바이더 간 장애 조치.', '会话粘性、429 冷却，并在各 OAuth 提供商间故障转移。', 'Привязка сессий, охлаждение при 429 и переключение между OAuth-провайдерами.', 'セッション固定、429 クールダウン、各 OAuth プロバイダー間のフェイルオーバー。'), href: `${prefix}guides/codex-integration/` },
		{ title: t('Nothing you delete is gone', '삭제해도 사라지지 않음', '删除的东西不会真的消失', 'Ничто удалённое не пропадает', '消したものは消えません'), body: t('Every account, key and setting is snapshotted to a local git history before it changes.', '모든 계정·키·설정은 변경 전에 로컬 git 기록으로 스냅샷.', '每个账号、密钥与设置在变更前都会快照进本地 git 历史。', 'Каждый аккаунт, ключ и настройка снимаются в локальную git-историю до изменения.', 'アカウント・キー・設定は変更前にローカル git 履歴へスナップショット。'), href: `${prefix}guides/web-dashboard/` },
		{ title: t('Usage and cost', '사용량과 비용', '用量与成本', 'Расход и стоимость', '使用量とコスト'), body: t('Local token accounting. Missing usage is shown as missing, never as zero.', '로컬 토큰 집계. 누락된 사용량은 0이 아니라 누락으로 표시.', '本地 token 统计。缺失的用量显示为缺失，而不是 0。', 'Локальный учёт токенов. Отсутствующие данные показаны как отсутствующие, а не как ноль.', 'ローカルでトークン集計。欠測は 0 ではなく欠測として表示。'), href: `${prefix}guides/web-dashboard/` },
	]},
	{ group: t('Clients', '클라이언트', '客户端', 'Клиенты', 'クライアント'), items: [
		{ title: 'Claude Code', body: t('GPT and Gemini inside Claude Code, with or without a Claude account.', 'Claude 계정 유무와 무관하게 Claude Code 안에서 GPT와 Gemini 사용.', '在 Claude Code 里用 GPT 与 Gemini，有没有 Claude 账号都行。', 'GPT и Gemini внутри Claude Code — с аккаунтом Claude или без него.', 'Claude アカウントの有無に関わらず Claude Code の中で GPT と Gemini。'), href: `${prefix}guides/claude-code/` },
		{ title: 'Grok Build', body: t('Models registered straight into your Grok configuration.', 'Grok 설정에 바로 등록되는 모델.', '模型直接注册进你的 Grok 配置。', 'Модели, зарегистрированные прямо в конфигурации Grok.', 'Grok の設定に直接登録されるモデル。'), href: `${prefix}guides/grok-build/` },
		{ title: t('Launcher and terminal', '런처와 터미널', '启动器与终端', 'Лаунчер и терминал', 'ランチャーとターミナル'), body: t('Install and open the agent CLIs, or run commands without leaving the app.', '에이전트 CLI를 설치·실행하거나 앱 안에서 명령 실행.', '安装并打开各 agent CLI，或直接在应用内执行命令。', 'Устанавливайте и открывайте CLI агентов или выполняйте команды не выходя из приложения.', 'エージェント CLI を導入・起動、あるいはアプリ内でコマンド実行。'), href: `${prefix}guides/launcher-and-terminal/` },
	]},
	{ group: t('Operating it', '운영', '运维', 'Эксплуатация', '運用'), items: [
		{ title: 'Docker', body: t('A supervising entrypoint, so the dashboard’s restart works inside a container.', '컨테이너 안에서도 대시보드 재시작이 동작하는 관리 엔트리포인트.', '带监督的入口点，容器内也能正常执行控制台重启。', 'Наблюдающая точка входа, чтобы перезапуск из дашборда работал в контейнере.', '監督付きエントリポイントで、コンテナ内でも再起動が効きます。'), href: `${prefix}guides/docker/` },
		{ title: t('Remote access', '원격 접속', '远程访问', 'Удалённый доступ', 'リモートアクセス'), body: t('Expose the proxy to your LAN behind a required credential.', '필수 자격 증명 뒤에서 LAN에 프록시 노출.', '在必需凭据保护下，把代理开放到局域网。', 'Откройте прокси в локальной сети за обязательными учётными данными.', '必須の資格情報の後ろで LAN に公開。'), href: `${prefix}guides/web-dashboard/` },
		{ title: t('Headless parity', '헤드리스 동등성', '无界面对等', 'Паритет без GUI', 'ヘッドレス同等'), body: t('Anything the dashboard can do, the CLI can do. A test enforces it.', '대시보드가 할 수 있는 일은 CLI도 할 수 있음. 테스트로 강제.', '控制台能做的，CLI 都能做，并由测试强制保证。', 'Всё, что умеет дашборд, умеет и CLI. Это проверяется тестом.', 'ダッシュボードにできることは CLI にもできる。テストで担保。'), href: `${prefix}reference/cli/` },
	]},
];

const docsMap = [
	{
		label: t('Getting Started', '시작하기', '开始使用', 'Начало работы', 'はじめに'),
		links: [
			{ label: t('Installation', '설치', '安装', 'Установка', 'インストール'), href: `${prefix}getting-started/installation/` },
			{ label: t('Quickstart', '빠른 시작', '快速开始', 'Быстрый старт', 'クイックスタート'), href: `${prefix}getting-started/quickstart/` },
