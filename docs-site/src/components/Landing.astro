const tabs = [
	{ id: 'overview', label: t('Overview', '개요', '概览', 'Обзор', '概要') },
	{ id: 'screens', label: t('Screens', '화면', '界面', 'Экраны', '画面') },
	{ id: 'features', label: t('Features', '기능', '功能', 'Возможности', '機能') },
	{ id: 'quickstart', label: t('Quickstart', '빠른 시작', '快速开始', 'Быстрый старт', 'クイックスタート') },
