---
/**
 * The site's appearance control: theme, seed colour, density and typography,
 * applied live and persisted.
 *
 * Two scripts, deliberately:
 *
 * 1. An `is:inline` script that resolves the stored light/dark choice *before*
 *    first paint. It sets only `data-theme`, which is enough: the stylesheet
 *    already carries correct role values for both themes at the default seed,
 *    so the first frame is right for everyone who has not picked a custom
 *    accent. Without it every visit flashes the wrong theme for a frame.
 *    Importing the token engine here instead would block rendering on a module
 *    fetch, which costs more than the flash it prevents.
 * 2. The module below, which applies the full token set (seed, density, type)
 *    and drives the panel once the page is interactive.
 *
 * The panel is a non-modal popover anchored to its button, per the appearance
 * rules — it never blocks reading the page it is restyling, and it returns
 * focus to the button on close.
 *
 * Everything here binds on `astro:page-load` rather than at module scope.
 * With a client-side router in place, a module script runs on the first
 * document and is *skipped* on every subsequent swap, so a one-time binding
 * would leave the panel's button dead from the second page onwards — while the
 * build still reported success. `astro:page-load` fires on the initial load
 * too, so this is not a fallback path, it is the path.
 */
import { FONT_STACKS, SEED_SWATCHES } from "../lib/appearance";
import SettingsSearch from "./SettingsSearch.tsx";

// The panel's own copy is still English while the language-mode work lands; the
// search bar below is translated, because it comes from `lib/strings.ts`.
const locale = Astro.locals.starlightRoute.locale ?? "root";
---

{/*
  Runs before first paint. Deliberately tiny and dependency-free. Wrapped in
  try/catch because a blocked or full localStorage must not stop the page from
  rendering at all. Its text is byte-identical on all 156 pages, which is what
  makes the view-transition swap preserve it in the head instead of re-running it.
*/}
<script is:inline>
  try {
    var stored = JSON.parse(localStorage.getItem("ocx-docs:appearance") || "null");
    var mode = stored && stored.theme ? stored.theme : "system";
    var dark = mode === "dark" || (mode !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
  } catch (e) { /* leave the server-rendered theme in place */ }
</script>

<div class="m3-appearance" data-m3-el="appearance">
  <button
    type="button"
    class="m3-appearance__toggle"
    aria-expanded="false"
    aria-controls="m3-appearance-panel"
    aria-label="Appearance settings"
    title="Appearance settings"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
      <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
      <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
      <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
      <path d="M12 2a10 10 0 0 0 0 20 2 2 0 0 0 2-2 2 2 0 0 1 2-2h2a4 4 0 0 0 4-4 10 10 0 0 0-10-10Z" />
    </svg>
  </button>

  <div id="m3-appearance-panel" class="m3-appearance__panel" hidden role="dialog" aria-label="Appearance" data-settings-root>
    {/*
      Every settings surface carries its own search bar wired to the regex
      builder — including this one, which is six rows and exactly the kind of
      surface someone would call obviously scannable. It searches each row's
      label, its description and its *current value*, so "700" finds the weight
      row because the weight row is currently showing 700.

      `client:visible` is doing real work here: the panel starts `hidden`, a
      hidden element never intersects, so this island costs nothing at all until
      somebody opens appearance settings.
    */}
    <SettingsSearch client:visible tab="Appearance" locale={locale} />

    <div class="m3-appearance__row" data-setting-id="theme" data-setting-desc="Light, dark or follow the operating system">
      <span class="m3-appearance__label" id="m3-ap-theme" data-setting-label>Theme</span>
      <div class="m3-appearance__chips" role="group" aria-labelledby="m3-ap-theme">
        <button type="button" data-theme-set="light">Light</button>
        <button type="button" data-theme-set="dark">Dark</button>
        <button type="button" data-theme-set="system">System</button>
      </div>
    </div>

    <div class="m3-appearance__row" data-setting-id="seed" data-setting-desc="Seed colour every Material 3 role is derived from">
      <label class="m3-appearance__label" for="m3-ap-seed" data-setting-label>Accent colour</label>
      <div class="m3-appearance__chips">
        {SEED_SWATCHES.map(hex => (
          <button
            type="button"
            class="m3-appearance__swatch"
            data-seed={hex}
            style={`background:${hex}`}
            aria-label={`Accent ${hex}`}
            title={hex}
          />
        ))}
        {/*
          A continuous picker, not a swatch grid — the swatches above are
          shortcuts layered on it. It is the platform control for now; the
          project's own infinite picker (with the colour-space translator,
          alpha, gamut and contrast readout the rules require) replaces this
          input without changing anything else on this panel, because the value
          that leaves here is just a hex string.
        */}
        <input id="m3-ap-seed" type="color" aria-label="Custom accent colour" />
        <span class="m3-appearance__value" data-value="seed"></span>
      </div>
    </div>

    <div class="m3-appearance__row" data-setting-id="density" data-setting-desc="Spacing and control heights, 1 compact to 5 comfortable">
      <label class="m3-appearance__label" for="m3-ap-density" data-setting-label>Density <span class="m3-appearance__value" data-value="density"></span></label>
      <input id="m3-ap-density" type="range" min="1" max="5" step="1" />
    </div>

    <div class="m3-appearance__row" data-setting-id="font" data-setting-desc="Interface typeface; every stack has a CJK-safe fallback">
      <label class="m3-appearance__label" for="m3-ap-font" data-setting-label>Typeface</label>
      <select id="m3-ap-font">
        {FONT_STACKS.map(font => <option value={font.id}>{font.label}</option>)}
      </select>
    </div>

    <div class="m3-appearance__row" data-setting-id="scale" data-setting-desc="Type scale, 80% to 160% of the default size">
      <label class="m3-appearance__label" for="m3-ap-scale" data-setting-label>Text size <span class="m3-appearance__value" data-value="scale"></span></label>
      <input id="m3-ap-scale" type="range" min="0.8" max="1.6" step="0.05" />
    </div>

    <div class="m3-appearance__row" data-setting-id="weight" data-setting-desc="Interface font weight, 300 light to 700 bold">
      <label class="m3-appearance__label" for="m3-ap-weight" data-setting-label>Weight <span class="m3-appearance__value" data-value="weight"></span></label>
      <input id="m3-ap-weight" type="range" min="300" max="700" step="100" />
    </div>

    {/*
      The live preview carries CJK alongside Latin on purpose: every stack in
      `FONT_STACKS` has a CJK-safe tail, and the only honest way to show that it
      works is to render characters that need it.
    */}
    <p class="m3-appearance__preview" data-preview>Aa Bb Cc 0123 — 廣東話 · 한국어 · 日本語</p>

    <button type="button" class="m3-appearance__reset">Reset to defaults</button>
  </div>
</div>

<script>
  import {
    DEFAULT_APPEARANCE,
    FONT_STACKS,
    applyAppearance,
    installAppearanceRuntime,
    normalizeSeed,
    readAppearance,
    writeAppearance,
    type DocsAppearance,
  } from "../lib/appearance";

  /** The single source for what the controls currently show. */
  let current: DocsAppearance = readAppearance();

  /**
   * Bind whatever panel is in the document right now.
   *
   * Called again after every client-side navigation because the header — and
   * therefore this panel — is re-rendered by the swap, leaving the previous
   * bindings attached to nodes that are no longer in the page. The listeners
   * are attached to fresh elements each time, so nothing accumulates; the
   * document-level listeners are installed once by `installAppearanceRuntime`.
   */
  function bind(): void {
    const root = document.querySelector<HTMLElement>(".m3-appearance");
    if (!root) return;
    const toggle = root.querySelector<HTMLButtonElement>(".m3-appearance__toggle")!;
    const panel = root.querySelector<HTMLElement>(".m3-appearance__panel")!;

    const commit = (patch: Partial<DocsAppearance>) => {
      current = { ...current, ...patch };
      applyAppearance(current);
      writeAppearance(current);
      sync();
    };

    /** Push the live values back into the controls so the panel never lies. */
    function sync(): void {
      for (const button of panel.querySelectorAll<HTMLButtonElement>("[data-theme-set]")) {
        button.setAttribute("aria-pressed", String(button.dataset.themeSet === current.theme));
      }
      for (const swatch of panel.querySelectorAll<HTMLButtonElement>("[data-seed]")) {
        swatch.setAttribute("aria-pressed", String(swatch.dataset.seed?.toLowerCase() === current.seed.toLowerCase()));
      }
      (panel.querySelector("#m3-ap-seed") as HTMLInputElement).value = current.seed;
      (panel.querySelector("#m3-ap-density") as HTMLInputElement).value = String(current.density);
      (panel.querySelector("#m3-ap-font") as HTMLSelectElement).value = current.fontId;
      (panel.querySelector("#m3-ap-scale") as HTMLInputElement).value = String(current.fontScale);
      (panel.querySelector("#m3-ap-weight") as HTMLInputElement).value = String(current.fontWeight);
      const readouts: Record<string, string> = {
        seed: current.seed,
        density: String(current.density),
        scale: `${Math.round(current.fontScale * 100)}%`,
        weight: String(current.fontWeight),
      };
      for (const node of panel.querySelectorAll<HTMLElement>("[data-value]")) {
        node.textContent = readouts[node.dataset.value ?? ""] ?? "";
      }

      /*
        The live value, stamped onto each row for the settings search to read.

        Written here rather than derived by the search because this function is
        already the one place that knows what every control is showing — a second
        reader that inspected the inputs itself would have to re-derive "Geist"
        from the id "geist" and would drift the day a row grows a second control.
        Stamped on every sync, so a search for "700" answers about the weight the
        panel is showing right now.
      */
      const rowValues: Record<string, string> = {
        ...readouts,
        theme: current.theme,
        font: FONT_STACKS.find(f => f.id === current.fontId)?.label ?? current.fontId,
      };
      for (const row of panel.querySelectorAll<HTMLElement>("[data-setting-id]")) {
        row.dataset.settingValue = rowValues[row.dataset.settingId ?? ""] ?? "";
      }
    }

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      if (!open) toggle.focus();
    };

    toggle.addEventListener("click", () => setOpen(panel.hidden));
    // Document-level handlers are re-added per navigation along with the panel
    // they close; each one is scoped to the panel captured in this closure, and
    // the old panel is no longer in the document, so a stale handler is a no-op.
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && !panel.hidden) setOpen(false);
    });
    document.addEventListener("click", event => {
      if (!panel.hidden && !root.contains(event.target as Node)) setOpen(false);
    });

    for (const button of panel.querySelectorAll<HTMLButtonElement>("[data-theme-set]")) {
      button.addEventListener("click", () => commit({ theme: button.dataset.themeSet as DocsAppearance["theme"] }));
    }
    for (const swatch of panel.querySelectorAll<HTMLButtonElement>("[data-seed]")) {
      swatch.addEventListener("click", () => {
        const seed = normalizeSeed(swatch.dataset.seed);
        if (seed) commit({ seed });
      });
    }
    panel.querySelector("#m3-ap-seed")!.addEventListener("input", event => {
      const seed = normalizeSeed((event.target as HTMLInputElement).value);
      if (seed) commit({ seed });
    });
    panel.querySelector("#m3-ap-density")!.addEventListener("input", event => {
      commit({ density: Number((event.target as HTMLInputElement).value) as DocsAppearance["density"] });
    });
    panel.querySelector("#m3-ap-font")!.addEventListener("change", event => {
      commit({ fontId: (event.target as HTMLSelectElement).value as DocsAppearance["fontId"] });
    });
    panel.querySelector("#m3-ap-scale")!.addEventListener("input", event => {
      commit({ fontScale: Number((event.target as HTMLInputElement).value) });
    });
    panel.querySelector("#m3-ap-weight")!.addEventListener("input", event => {
      commit({ fontWeight: Number((event.target as HTMLInputElement).value) });
    });
    panel.querySelector(".m3-appearance__reset")!.addEventListener("click", () => {
      current = { ...DEFAULT_APPEARANCE };
      applyAppearance(current);
      writeAppearance(current);
      sync();
    });

    applyAppearance(current);
    sync();
  }

  // Installed once; survives every swap because `document` does.
  installAppearanceRuntime(() => current);
  document.addEventListener("astro:page-load", bind);
</script>
